  "_description": "Jackknife resampling for variance estimation, bias correction, and comparison with bootstrap. Validates the delete-one jackknife against analytical variance of the mean, tests bias correction on a biased estimator, and compares block jackknife variance with bootstrap on correlated data.",
  "_groundspring_question": "Does jackknife error estimation achieve subpercent accuracy for variance of smooth statistics on known distributions?",
  "_cross_spring": ["Exp 007 RAWR bootstrap", "Exp 003 FAO-56 MC propagation"],

  "gaussian": {
    "n_samples": 200,
    "true_mean": 5.0,
    "true_std": 2.0,
    "seed": 42
