  "exponential": {
    "n_samples": 200,
    "rate": 0.5,
    "seed": 99
  },
  "correlated": {
    "n_samples": 400,
    "true_mean": 10.0,
    "true_std": 3.0,
    "ar1_phi": 0.8,
    "block_sizes": [1, 5, 10, 20, 40],
    "seed": 77
  },
  "analytical_predictions": {
    "gaussian_var_of_mean": "sigma^2 / N = 4.0 / 200 = 0.02",
    "exponential_mean": "1/rate = 2.0",
    "exponential_var_of_mean": "1/(rate^2 * N) = 4.0 / 200 = 0.02",
    "jackknife_variance_formula": "var_JK = (N-1)/N * sum((theta_i - theta_bar)^2)",
    "jackknife_bias_formula": "bias_JK = (N-1) * (theta_bar_JK - theta_full)",
    "block_jackknife_effective_n": "N / block_size"
  },
  "bootstrap_comparison": {
    "n_bootstrap": 500,
    "seed": 12345,
